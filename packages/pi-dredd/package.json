{
  "name": "@casualjim/pi-dredd",
  "version": "0.1.6",
  "description": "Judge-everything guard extension for pi and omp: action gates, verifier guards, violation ledger, direct-trust memory, own decisions client",
  "keywords": [
    "pi-package",
    "dredd",
    "guard",
    "jev",
    "decisions"
  ],
  "license": "MIT",
  "author": "casualjim",
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  },
  "type": "module",
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:pack": "pnpm pack --dry-run",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./extensions/dredd.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/dredd.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.3.37",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
