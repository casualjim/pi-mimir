{
  "name": "@casualjim/pi-todo-herdr",
  "version": "0.3.9",
  "description": "Hierarchical task tools for Pi with a live widget and Herdr sidebar integration.",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "todo",
    "task-management",
    "herdr",
    "productivity"
  ],
  "author": {
    "name": "casualjim"
  },
  "license": "MIT",
  "homepage": "https://github.com/casualjim/pi-mimir/tree/main/packages/pi-todo-herdr",
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://github.com/leset0ng/pi-todo-herdr/raw/main/media/screenshot.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.3.37",
    "typescript": "^7.0.2"
  }
}
