{
  "name": "@casualjim/pi-openspec",
  "version": "0.1.3",
  "license": "MIT",
  "description": "OpenSpec-driven development workflow for Pi Agent",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
    "extensions/",
    "skillseeds/",
    "agents/",
    "openspec/",
    "rules/",
    "templates/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "extensions/openspec"
    ],
    "skills": [
      "./skillseeds"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.78.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node --experimental-strip-types tests/integration/run-e2e.ts",
    "typecheck": "tsc --noEmit",
    "check:pack": "npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  }
}
