{
  "name": "@casualjim/pi-cavekit",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Cavekit SPEC.md workflow packaged for Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
