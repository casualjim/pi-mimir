{
  "name": "@casualjim/pi-review",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Codex-style code review command for Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
    "extensions/",
    "skills/",
    "agents/",
    "prompts/",
    "README.md",
    "index.js"
  ],
  "pi": {
    "extensions": [
      "extensions/review"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pack": "npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  }
}
