{
  "name": "@casualjim/pi-heimdall",
  "version": "0.3.7",
  "description": "Guardian extension for pi — security guards that block accidental secret exposure, enforce command policies, protect .env files, and sandbox bash commands",
  "keywords": [
    "pi-package",
    "pi-extension",
    "security",
    "secrets",
    "sops",
    "kubectl"
  ],
  "license": "MIT",
  "author": "casualjim",
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  },
  "type": "module",
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:pack": "pnpm pack --dry-run",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./extensions/heimdall.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^24.13.4",
    "@types/shell-quote": "^1.7.5",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@casualjim/heimdall-sandbox": "^0.2.6",
    "@casualjim/pi-pretty": "workspace:*",
    "ignore": "^7.0.9",
    "jsonc-parser": "^3.3.1",
    "shell-quote": "^1.10.0"
  }
}
