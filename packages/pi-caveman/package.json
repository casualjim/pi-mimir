{
  "name": "@casualjim/pi-caveman",
  "version": "0.2.8",
  "license": "MIT",
  "description": "Caveman skills packaged for Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
    "skills/",
    "agents/",
    "extensions/",
    "README.md",
    "LICENSE",
    "index.js"
  ],
  "pi": {
    "skills": [
      "skills"
    ],
    "extensions": [
      "extensions/caveman"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node --experimental-strip-types tests/integration/run-e2e.ts",
    "typecheck": "tsc --noEmit",
    "check:pack": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  }
}
