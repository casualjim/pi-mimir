{
  "name": "@casualjim/pi-hindsight",
  "version": "0.1.9",
  "license": "MIT",
  "description": "Pi extension that wraps the official hindsight-coding-agents pi.js and adds template-aware recall/reflect tags for shared-bank setups (per-project filter + untagged global layer)",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "extensions/hindsight/index.js",
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "extensions/hindsight"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
