{
  "name": "@casualjim/pi-pstack",
  "version": "0.1.3",
  "description": "Pi-native fork of pstack skills, Poteto Mode, and bundled agents. Delegates through pi-herdr-agents instead of its own subagent tool.",
  "license": "MIT",
  "author": "casualjim",
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "subagent",
    "pstack"
  ],
  "type": "module",
  "files": [
    "extensions/",
    "skills/",
    "agents/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  },
  "pi": {
    "extensions": [
      "./extensions/pstack"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:pack": "pnpm pack --dry-run",
    "test": "bun tests/agents-contract.ts && bun test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.13.4",
    "commander": "^15.0.0",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
