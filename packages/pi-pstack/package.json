{
  "name": "@casualjim/pi-pstack",
  "version": "0.1.21",
  "description": "pstack skills, Poteto Mode, and bundled agents for pi and omp. Delegates through pi-herdr-agents instead of its own subagent tool.",
  "license": "MIT",
  "author": "casualjim",
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "subagent",
    "pstack"
  ],
  "type": "module",
  "files": [
    "extensions/",
    "skills/",
    "agents/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  },
  "pi": {
    "extensions": [
      "./extensions/pstack"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:pack": "pnpm pack --dry-run",
    "test": "bun tests/agents-contract.ts && bun tests/extension-contract.ts && bun test --path-ignore-patterns '**/statechart/**' && node --test skills/statechart/scripts/test/statechart.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^26.6.5",
    "commander": "^15.0.0",
    "typebox": "^1.3.37",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
