{
  "name": "@casualjim/pi-pretty",
  "version": "0.7.13",
  "description": "Pretty terminal output for pi built-in tools: shiki-highlighted read previews, ls tree with icons, FFF-accelerated find/grep, prompt editor and activity indicators.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "pretty-print",
    "shiki",
    "syntax-highlighting",
    "terminal"
  ],
  "homepage": "https://github.com/casualjim/pi-mimir/tree/main/packages/pi-pretty",
  "license": "MIT",
  "author": "casualjim",
  "repository": {
    "type": "git",
    "url": "https://github.com/casualjim/pi-mimir"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:pack": "pnpm pack --dry-run",
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^26.6.5",
    "jiti": "^2.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.11.0",
    "@shikijs/cli": "^4.5.0",
    "shiki": "4.5.0"
  }
}
